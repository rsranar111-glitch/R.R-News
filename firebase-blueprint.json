{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings, metadata and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Portfolio": {
      "title": "Portfolio",
      "description": "User financial asset holdings and portfolio items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "holdings": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/portfolios/{userId}": {
      "schema": "Portfolio",
      "description": "User investment portfolio holdings"
    }
  }
}
